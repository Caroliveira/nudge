# App Configuration
APP_URL=http://localhost:3000

# AWS DynamoDB Configuration
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
DYNAMODB_TABLE_NAME=nudge_tasks

# Optional: Endpoint for DynamoDB Local (e.g. docker run -p 8000:8000 amazon/dynamodb-local)
# DYNAMODB_ENDPOINT=http://localhost:8000

# Resend Email Configuration (Optional in dev: prints magic link to terminal when unset)
RESEND_API_KEY=
EMAIL_FROM=Nudge <onboarding@resend.dev>

# Session Secret (Optional in dev, required in production: openssl rand -base64 32)
SESSION_SECRET=

